# Production build (`npm run build`). Origin of the Laravel backend, which
# also serves the uploaded photos (/storage/..., /api/product-photos/...).
# src/lib/media.ts turns any relative photo path into a link on this host,
# because the SPA itself runs on www.nearbybalikpapan.com.
VITE_API_URL=https://api.nearbybalikpapan.com
