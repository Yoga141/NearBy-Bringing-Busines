# BEGIN NearBy SPA fallback
# Vue Router uses HTML5 history URLs (/umkm/5, /dashboard/all). Without this,
# refreshing or opening such a link directly makes Apache answer 404, because
# no such file exists. Real files (assets) and the API folder are left alone.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ensure Authorization header is passed to PHP
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

    # Force /api requests to be handled by the backend symlink entrypoint
    RewriteCond %{REQUEST_URI} ^/api(/|$)
    RewriteRule ^api/(.*)$ api/index.php [L,QSA]

    # Fallback all other non-file/non-dir requests to index.html for SPA
    RewriteCond %{REQUEST_URI} !^/api(/|$)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
# END NearBy SPA fallback
