# Production build settings. The SPA calls the API at the same origin (/api),
# so no API URL is needed here - see src/lib/api.ts and .cpanel.yml.
#
# Optional: URL of the Python voice-NLP service (nlp-service/) if it is
# deployed somewhere. Leave empty on the cPanel host: the voice assistant then
# uses its built-in rules.
VITE_VOICE_NLP_URL=
