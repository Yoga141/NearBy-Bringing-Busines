# Template for the server's backend/.env (cPanel: /home/nearby/nearby-backend/.env).
# Copy to .env on the server and fill in the blanks. Never commit the real file.

APP_NAME=NearBy
APP_ENV=production
# Generate once on the server: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://nearbybalikpapan.com

# Only needed if the SPA is served from a different domain than the API.
FRONTEND_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL database created in cPanel -> MySQL Databases (user needs ALL PRIVILEGES).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Required before `php artisan db:seed` in production (the seeder refuses the
# README demo passwords). Skip seeding entirely if you only want real data.
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_USER_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MEDIA_DISK=public

# Largest guide video an admin may upload (MB); php.ini limits apply too.
GUIDE_VIDEO_MAX_MB=64

# Optional wording layer for the chat assistant (see .env.example).
ANTHROPIC_API_KEY=
